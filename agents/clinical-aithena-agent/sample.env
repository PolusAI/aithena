# ============================================================================
# PostgreSQL Database Configuration
# ============================================================================
# Copy this file to .env and update with your settings:
#   cp sample.env .env
#
# The ct-aithena CLI will automatically load variables from .env
# ============================================================================

# PostgreSQL Connection Details (you should change these values)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=clinical_aithena # you should keep this the same

# Full Database URL (used by SQLModel/SQLAlchemy)
# For psycopg2 (older driver): postgresql://[user]:[password]@[host]:[port]/[database]
# For psycopg3 (newer driver): postgresql+psycopg://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME_POSTGRES_PASSWORD@localhost:5432/clinical_aithena

# Optional: For production, use a stronger password and consider using connection pooling
# DATABASE_URL=postgresql+psycopg://user:strongpassword@host:5432/clinical_aithena?pool_size=20&max_overflow=0

# For async connections with psycopg3:
# DATABASE_URL=postgresql+psycopg_async://user:password@host:5432/database

# ============================================================================
# API Configuration (FastAPI)
# ============================================================================
# These settings are used by the Clinical Aithena FastAPI application

# API Metadata
API_TITLE=Clinical Aithena API
API_VERSION=0.1.0
API_DESCRIPTION=API for querying clinical trials data

# CORS Configuration (comma-separated list of allowed origins)
# Use "*" for development, restrict to specific domains in production
CORS_ORIGINS=*

# ============================================================================
# LLM Configuration (OpenAI-compatible endpoint, e.g. LiteLLM proxy)
# ============================================================================
# The LLMConfig class reads env vars with the LLM_ prefix.
# Fallback: OPENAI_API_KEY and OPENAI_ENDPOINT are also accepted.

# LLM Model name (must match a model configured in your LLM endpoint)
LLM_MODEL=gpt-4.1

# LLM API Base URL (OpenAI-compatible endpoint)
LLM_API_BASE=http://localhost:4000

# LLM API Key (required for authentication)
LLM_API_KEY=your-api-key-here

# MedCPT Embedding Model Names (as configured in LiteLLM)
MEDCPT_ARTICLE_MODEL=medcpt-article
MEDCPT_QUERY_MODEL=medcpt-query

# ============================================================================
# RabbitMQ Configuration (for GARDIAN real-time status updates)
# ============================================================================
# Used by the FastAPI backend to publish pipeline progress via AMQP.
# The frontend connects to RabbitMQ via Web STOMP (WebSocket).

RABBITMQ_URL=amqp://guest:guest@localhost/

# ============================================================================
# Test Configuration
# ============================================================================
# Database URL for integration tests (can be the same as DATABASE_URL)
# TEST_DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME_POSTGRES_PASSWORD@localhost:5432/clinical_aithena
