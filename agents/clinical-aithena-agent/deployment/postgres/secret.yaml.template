apiVersion: v1
kind: Secret
metadata:
  name: clinical-aithena-db-secret
  namespace: clinical-aithena
type: Opaque
stringData:
  # Plain text values (Kubernetes will automatically base64 encode them)
  
  # Admin/write user credentials
  username: ctgov
  password: CHANGE_ME_ADMIN_PASSWORD
  
  # Read-only service account credentials
  readonly_username: ctgov_readonly
  readonly_password: CHANGE_ME_READONLY_PASSWORD

