apiVersion: v1
kind: Secret
metadata:
  name: clinical-aithena-api-secret
  namespace: clinical-aithena
  labels:
    app: clinical-aithena-api
    component: api
type: Opaque
stringData:
  # Plain text values (Kubernetes will automatically base64 encode them)
  
  # Database connection URL for API (read-only user recommended for production)
  # Format: postgresql+psycopg://username:password@host:port/database
  # 
  # Using read-only user (recommended for production):
  database_url: "postgresql+psycopg://ctgov_readonly:CHANGE_ME_READONLY_PASSWORD@clinical-aithena-db-0.clinical-aithena-db.clinical-aithena.svc.cluster.local:5432/clinical_aithena"
  
  # Alternative: Using admin user (for development/testing only):
  # database_url: "postgresql+psycopg://ctgov:CHANGE_ME_ADMIN_PASSWORD@clinical-aithena-db-0.clinical-aithena-db.clinical-aithena.svc.cluster.local:5432/clinical_aithena"
  
  # LLM API key (shared LiteLLM proxy in box namespace)
  # This is the same key used by ask-aithena-agent
  llm_api_key: "CHANGE_ME_LLM_API_KEY"
  
  # Notes:
  # - Replace CHANGE_ME_READONLY_PASSWORD with the actual password from secret.yaml
  # - Replace CHANGE_ME_LLM_API_KEY with the LiteLLM API key
  # - The host uses the fully qualified domain name (FQDN) of the database service
  # - Uses read-only credentials for security (API only needs read access)

